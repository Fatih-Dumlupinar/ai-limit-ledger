      },
      {
        "command": "aiLimitLedger.disableClaudeOAuthUsage",
        "title": "%command.disableClaudeOAuthUsage%"
      },
      {
        "command": "aiLimitLedger.openExperimentalClaudeUsageDocs",
        "title": "%command.openExperimentalClaudeUsageDocs%"
      },
      {
        "command": "aiLimitLedger.connectCopilotUsage",
        "title": "%command.connectCopilotUsage%"
      },
      {
        "command": "aiLimitLedger.disconnectCopilotUsage",
        "title": "%command.disconnectCopilotUsage%"
