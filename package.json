      },
      {
        "command": "aiLimitLedger.openSafeDashboard",
        "title": "%command.openSafeDashboard%"
      },
      {
        "command": "aiLimitLedger.openRichDashboard",
        "title": "%command.openRichDashboard%"
      },
      {
        "command": "aiLimitLedger.selectDashboardMode",
        "title": "%command.selectDashboardMode%"
      },
      {
        "command": "aiLimitLedger.selectStatusBarMode",
        "title": "%command.selectStatusBarMode%"
      },
      {
        "command": "aiLimitLedger.selectPercentageDisplay",
        "title": "%command.selectPercentageDisplay%"
      },
      {
        "command": "aiLimitLedger.selectDisplayLanguage",
        "title": "%command.selectDisplayLanguage%"
      },
      {
        "command": "aiLimitLedger.resetDisplaySettings",
        "title": "%command.resetDisplaySettings%"
      },
      {
        "command": "aiLimitLedger.recoverDashboard",
