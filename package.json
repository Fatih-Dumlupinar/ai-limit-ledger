      },
      {
        "command": "aiLimitLedger.enableExperimentalCopilotUsage",
        "title": "%command.enableExperimentalCopilotUsage%"
      },
      {
        "command": "aiLimitLedger.disableExperimentalCopilotUsage",
        "title": "%command.disableExperimentalCopilotUsage%"
      },
      {
        "command": "aiLimitLedger.enableGrokUsage",
        "title": "%command.enableGrokUsage%"
      },
      {
        "command": "aiLimitLedger.disableGrokUsage",
        "title": "%command.disableGrokUsage%"
      },
      {
        "command": "aiLimitLedger.refreshGrokUsage",
        "title": "%command.refreshGrokUsage%"
      },
      {
        "command": "aiLimitLedger.recheckGrokInstallation",
        "title": "%command.recheckGrokInstallation%"
      },
      {
        "command": "aiLimitLedger.launchGrokLogin",
        "title": "%command.launchGrokLogin%"
      },
      {
        "command": "aiLimitLedger.diagnoseGrokIntegration",
        "title": "%command.diagnoseGrokIntegration%"
      },
      {
        "command": "aiLimitLedger.openGrokInstallGuide",
        "title": "%command.openGrokInstallGuide%"
      },
      {
        "command": "aiLimitLedger.openGrokUsage",
        "title": "%command.openGrokUsage%"
      },
      {
        "command": "aiLimitLedger.enableExperimentalGrokUsage",
        "title": "%command.enableExperimentalGrokUsage%"
      },
      {
        "command": "aiLimitLedger.disableExperimentalGrokUsage",
        "title": "%command.disableExperimentalGrokUsage%"
      },
      {
        "command": "aiLimitLedger.repairClaudeCodeIntegration",
        "title": "%command.repairClaudeCodeIntegration%"
      },
      {
        "command": "aiLimitLedger.enableClaudeAutomaticRepair",
        "title": "%command.enableClaudeAutomaticRepair%"
      },
      {
        "command": "aiLimitLedger.disableClaudeAutomaticRepair",
        "title": "%command.disableClaudeAutomaticRepair%"
      },
      {
        "command": "aiLimitLedger.recheckClaudeIntegrationHealth",
        "title": "%command.recheckClaudeIntegrationHealth%"
      },
      {
        "command": "aiLimitLedger.diagnoseClaudeCodeIntegration",
        "title": "%command.diagnoseClaudeCodeIntegration%"
      },
      {
        "command": "aiLimitLedger.diagnoseCodexIntegration",
        "title": "%command.diagnoseCodexIntegration%"
      },
      {
        "command": "aiLimitLedger.openCodexUsagePage",
        "title": "%command.openCodexUsagePage%"
      },
      {
        "command": "aiLimitLedger.openClaudeUsagePage",
        "title": "%command.openClaudeUsagePage%"
      },
      {
        "command": "aiLimitLedger.openClaudeInstallGuide",
        "title": "%command.openClaudeInstallGuide%"
      },
      {
        "command": "aiLimitLedger.launchClaudeInTerminal",
        "title": "%command.launchClaudeInTerminal%"
      },
      {
        "command": "aiLimitLedger.copyClaudeDiagnostics",
        "title": "%command.copyClaudeDiagnostics%"
      },
      {
        "command": "aiLimitLedger.openClaudeCode",
        "title": "%command.openClaudeCode%"
      },
      {
        "command": "aiLimitLedger.copyClaudeUsageCommand",
        "title": "%command.copyClaudeUsageCommand%"
      },
      {
        "command": "aiLimitLedger.openCliEnhancedModeDocs",
        "title": "%command.openCliEnhancedModeDocs%"
      },
      {
        "command": "aiLimitLedger.selectProviders",
        "title": "%command.selectProviders%"
      },
      {
        "command": "aiLimitLedger.restartAppServer",
        "title": "%command.restartAppServer%"
      },
      {
        "command": "aiLimitLedger.openSettings",
        "title": "%command.openSettings%"
      },
      {
        "command": "aiLimitLedger.showLogs",
        "title": "%command.showLogs%"
      },
      {
        "command": "aiLimitLedger.copyRedactedDiagnostics",
        "title": "%command.copyRedactedDiagnostics%"
      },
      {
        "command": "aiLimitLedger.copyRedactedEffectiveSettings",
        "title": "%command.copyRedactedEffectiveSettings%"
