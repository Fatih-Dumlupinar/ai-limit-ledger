{
  "name": "ai-limit-ledger",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.6.2",
  "publisher": "fatihdumlupinar-dev",
  "private": true,
  "preview": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fatih-Dumlupinar/ai-limit-ledger.git"
  },
  "bugs": {
    "url": "https://github.com/Fatih-Dumlupinar/ai-limit-ledger/issues"
  },
  "homepage": "https://github.com/Fatih-Dumlupinar/ai-limit-ledger#readme",
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=22.12.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "ai usage",
    "usage monitor",
    "quota",
    "rate limit",
    "rate limits",
    "reset time",
    "token usage",
    "codex",
    "chatgpt",
    "claude code",
    "github copilot",
    "grok",
    "privacy",
    "developer tools",
    "status bar",
    "usage dashboard"
  ],
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#1e1b4b",
    "theme": "dark"
  },
  "main": "./out/extension.js",
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "aiLimitLedger.refresh",
        "title": "%command.refresh%"
      },
      {
        "command": "aiLimitLedger.refreshCodex",
        "title": "%command.refreshCodex%"
      },
      {
        "command": "aiLimitLedger.refreshClaude",
