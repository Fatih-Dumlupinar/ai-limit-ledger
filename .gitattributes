# Auto-detect text files and normalize line endings to LF in the repository.
* text=auto eol=lf

# Explicit text sources
*.ts text eol=lf
*.mts text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows/PowerShell scripts keep CRLF
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files — never diffed or line-ending-normalized
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.vsix binary
*.woff binary
*.woff2 binary
*.ttf binary

# Generated/vendored files excluded from GitHub's language stats and diffs
package-lock.json linguist-generated=true
CHANGELOG.md linguist-generated=false
