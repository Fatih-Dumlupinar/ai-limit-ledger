# Dependencies
node_modules/

# Build output (generated from src/ at build/CI time — see Task 12)
out/
dist/

# Test / coverage
coverage/
.vitest/
.nyc_output/

# Caches / scratch
.cache/
.tmp/
*.tmp

# Logs
*.log
debug.log
npm-debug.log*

# Environment / credentials
.env
.env.*
!.env.example
*.pem
*.key
*credentials*.json

# Packaged extension artifacts (built from source; not committed)
*.vsix

# Local audit / dependency-tree scratch output
*-audit.json
*-tree.json
audit-raw.json
deps-tree.json

# Provider-specific local snapshots/caches (never committed; user-machine state)
.claude-usage-cache/

# OS / editor local files
.DS_Store
Thumbs.db
*.swp
*~

# Editor-local settings (the project-shared .vscode/* development configuration stays tracked;
# anything else a contributor's editor drops in .vscode/ stays local — Task 14.1)
.vscode/*
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json

# Extension Development Host scratch state (separate user-data/extensions areas used by the
# "Run Extension — Clean Development Host" launch profile, so F5 never touches the normal VS Code
# profile that has the Marketplace build installed) — covered by the .tmp/ rule above, repeated
# here so the intent survives a future edit to that rule.
.tmp/vscode-dev/

# Backup files
*.bak
*.orig
